        "cv = GridSearchCV(estimator=KNeighborsClassifier(), param_grid=param_grid, cv=3, n_jobs=-1, scoring='recall')\n",
        "\n",
        "\n",
        "cv.fit(X_train, y_train)\n",
        "print(f'Mejor modelo: {cv.best_estimator_}')\n",
        "y_pred_cv = cv.predict(X_test)\n"
